---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const workshops = await getCollection('workshops');
  return workshops.map((workshop) => ({
    params: { workshop: workshop.id },
  }));
}

const { workshop } = Astro.params;
const backPath = `/workshops/${workshop}`;
---

<Layout>
  <nav class="absolute bottom-0 left-0 z-10 p-4">
    <a
      href={backPath}
      class="ui-text px-8 pt-3 pb-[calc(var(--spacing)*3.5)] rounded-full text-center flex items-center justify-center gap-4  focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#222222] text-[#222222] bg-[#EEEEEE]"
    >
      <span aria-hidden="true" class="text-xl leading-none">&#9664;</span>
      <span>Gallery List</span>
    </a>
  </nav>
  <main id="tool-container" class="h-screen w-screen"></main>
</Layout>

<script>
  const container = document.getElementById('tool-container') as HTMLDivElement;
  const url = new URLSearchParams(window.location.search).get('tool');

  if (!url) {
    console.error('No tool URL provided');
  }

  if (url) {
    const iframe = document.createElement('iframe');
    iframe.className = 'h-full w-full';
    iframe.title = 'Tool viewer';

    if (import.meta.env.DEV) {
      /* eslint-disable */
      const htmlContent = `
        <!DOCTYPE html>
        <html>
        <head>
          <script src="https://cdn.jsdelivr.net/npm/p5@1.11.11/lib/p5.min.js"><\/script>
          <script src="https://cdn.jsdelivr.net/npm/p5@1.11.11/lib/addons/p5.sound.min.js"><\/script>
          <style>
            body {
              margin: 0;
              padding: 0;
              height: 100vh;
              overflow: hidden;
              display: flex;
              justify-content: center;
              align-items: center;
            }
          </style>
        </head>
        <body><script src="${url}"><\/script></body>
        </html>`;
      /* eslint-enable */

      const blob = new Blob([htmlContent], { type: 'text/html' });
      const blobUrl = URL.createObjectURL(blob);
      iframe.src = blobUrl;

      iframe.addEventListener('load', () => {
        URL.revokeObjectURL(blobUrl);
      });
    } else {
      iframe.src = `https://p5-tool-viewer.michele-muffin.workers.dev/?tool=${encodeURIComponent(url)}`;
    }

    iframe.sandbox.add('allow-scripts', 'allow-same-origin', 'allow-downloads');
    iframe.allow = 'camera; microphone; accelerometer; gyroscope';

    container.appendChild(iframe);
  }
</script>
