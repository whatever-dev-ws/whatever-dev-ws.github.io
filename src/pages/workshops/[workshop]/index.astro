---
import Layout from '@layouts/Layout.astro';
import WorkshopViewer from '@components/WorkshopViewer.svelte';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const workshops = await getCollection('workshops');
  return workshops.map((workshop) => ({
    params: { workshop: workshop.id },
    props: { ...workshop.data },
  }));
}

const { pathname } = Astro.url;
const { title, remoteAssetsSlug, isActive } = Astro.props;

const remoteAssetsUrl = `${import.meta.env.PUBLIC_ASSETS_REPO_URL}/${remoteAssetsSlug}`;
---

<Layout>
  <main>
    <div class="mx-auto flex max-w-5xl flex-col gap-24 px-4 py-30 md:px-8">
      <header>
        <h1 class="hero-heading-text">{title}</h1>
      </header>
      <WorkshopViewer {remoteAssetsUrl} currentWorkshopPath={pathname} isWorkshopActive={isActive} client:load />
    </div>
  </main>
</Layout>
